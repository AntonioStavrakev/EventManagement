@model IEnumerable<EventViewModel>
@{
    ViewData["Title"] = "My Events";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Ownership</span>
        <h1>Моите събития</h1>
        <p>Тук виждаш само event-ите, които ти си създал и които можеш да редактираш или изтриеш.</p>
    </div>
    <a asp-action="Create" class="btn btn-brand">Create Event</a>
</section>

<div class="content-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Attendees</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>
                                <strong>@ev.Title</strong>
                                <div class="small text-muted">@ev.Location</div>
                            </td>
                            <td>@ev.StartDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td><span class="status-pill status-pill--@ev.Status.ToLowerInvariant()">@ev.Status</span></td>
                            <td>@ev.CurrentAttendees / @ev.MaxCapacity</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-dark">Details</a>
                                <a asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-sm btn-dark">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>Още нямаш създадени събития</h3>
            <p>Създай първото си събитие и после ще можеш да го редактираш, триеш и следиш участниците.</p>
            <a asp-action="Create" class="btn btn-brand">Create your first event</a>
        </div>
    }
</div>

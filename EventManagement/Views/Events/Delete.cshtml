@model EventViewModel
@{
    ViewData["Title"] = "Delete Event";
}

<div class="center-panel">
    <div class="content-card content-card--danger">
        <span class="eyebrow">Danger zone</span>
        <h1>Изтриване на събитие</h1>
        <p>На път си да изтриеш <strong>@Model.Title</strong>. Това действие е необратимо и ще премахне всички регистрации към него.</p>

        <ul class="detail-list mb-4">
            <li><strong>Дата</strong><span>@Model.StartDate.ToString("dd MMM yyyy, HH:mm")</span></li>
            <li><strong>Локация</strong><span>@Model.Location</span></li>
            <li><strong>Регистрации</strong><span>@Model.CurrentAttendees</span></li>
        </ul>

        <div class="d-flex flex-wrap gap-3">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark">Cancel</a>
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Delete permanently</button>
            </form>
        </div>
    </div>
</div>

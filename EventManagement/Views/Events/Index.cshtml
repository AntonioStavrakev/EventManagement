@using Microsoft.EntityFrameworkCore
@model IEnumerable<EventManagement.Core.ViewModels.EventViewModel>

@{
ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-semibold">Събития</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Нов Event
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
        <table class="table table-hover mb-0">
            <thead>
            <tr>
                <th>Заглавие</th>
                <th>Категория</th>
                <th>Дата</th>
                <th>Локация</th>
                <th>Участници</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var ev in Model)
            {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.Category</td>
                <td>@ev.StartDate.ToString("dd MMM yyyy")</td>
                <td>@ev.Location</td>
                <td>@ev.CurrentAttendees / @ev.MaxCapacity</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-secondary">View</a>
                    <a asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
            }
            </tbody>
        </table>
        }
        else
        {
        <div class="text-center p-4 text-muted">
            Няма събития
        </div>
        }
    </div>
</div>
@model EventDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="page-header">
    <div>
        <span class="eyebrow">@Model.Category</span>
        <h1>@Model.Title</h1>
        <p>@Model.StartDate.ToString("dd MMM yyyy, HH:mm") • @Model.Location • Организатор: @Model.OrganizerName</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <span class="status-pill status-pill--@Model.Status.ToLowerInvariant()">@Model.Status</span>
        @if (Model.IsOwner)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        }
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="content-card mb-4">
            <h2>Описание</h2>
            <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "Няма добавено описание." : Model.Description)</p>
        </div>

        <div class="content-card">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Attendees</span>
                    <h2>Последни регистрации</h2>
                </div>
                @if (Model.IsOwner)
                {
                    <a asp-controller="Attendees" asp-action="Index" asp-route-eventId="@Model.Id" class="btn btn-sm btn-outline-dark">Manage attendees</a>
                }
            </div>

            @if (Model.RecentAttendees.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Участник</th>
                                <th>Имейл</th>
                                <th>Статус</th>
                                <th>Билет</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attendee in Model.RecentAttendees)
                            {
                                <tr>
                                    <td>@attendee.FirstName @attendee.LastName</td>
                                    <td>@attendee.Email</td>
                                    <td><span class="status-pill status-pill--active">@attendee.Status</span></td>
                                    <td>@attendee.TicketNumber</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0 text-muted">Все още няма регистрации за това събитие.</p>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="content-card mb-4">
            <span class="eyebrow">Summary</span>
            <h2>Детайли</h2>
            <ul class="detail-list">
                <li><strong>Начало</strong><span>@Model.StartDate.ToString("dd MMM yyyy, HH:mm")</span></li>
                <li><strong>Край</strong><span>@Model.EndDate.ToString("dd MMM yyyy, HH:mm")</span></li>
                <li><strong>Цена</strong><span>@(Model.TicketPrice == 0 ? "Free" : $"{Model.TicketPrice:0.00} BGN")</span></li>
                <li><strong>Места</strong><span>@Model.CurrentAttendees / @Model.MaxCapacity</span></li>
                <li><strong>Свободни</strong><span>@Model.AvailableSpots</span></li>
            </ul>
        </div>

        <div class="content-card">
            <span class="eyebrow">Action</span>
            <h2>Какво следва</h2>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <p>Влез в профила си, за да се регистрираш и да управляваш свои събития.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-brand w-100">Login to continue</a>
            }
            else if (Model.IsOwner)
            {
                <p>Това е твое събитие. Можеш да редактираш детайлите, да изтриеш събитието или да управляваш участниците.</p>
                <a asp-controller="Attendees" asp-action="Index" asp-route-eventId="@Model.Id" class="btn btn-dark w-100">Open attendee list</a>
            }
            else if (Model.IsRegistered)
            {
                <p>Вече си регистриран за това събитие.</p>
                <form asp-action="Leave" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100">Leave event</button>
                </form>
            }
            else if (Model.CanRegister)
            {
                <p>Има свободни места и регистрацията е активна.</p>
                <form asp-action="Register" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-brand w-100">Register now</button>
                </form>
            }
            else
            {
                <p>Регистрацията в момента не е възможна за това събитие.</p>
            }
        </div>
    </div>
</div>

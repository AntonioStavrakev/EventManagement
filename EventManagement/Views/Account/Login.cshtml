@model EventManagement.Core.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div style="font-size:40px;">🔐</div>
                    <h4 class="fw-semibold mb-1">Вход в системата</h4>
                    <p class="text-muted mb-0" style="font-size:14px;">Използвай demo профил за презентацията.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Потребител</label>
                        <input asp-for="Username" class="form-control" placeholder="admin" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Парола</label>
                        <input asp-for="Password" class="form-control" placeholder="admin123" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-brand w-100">Вход</button>
                </form>

                <div class="mt-4 p-3 rounded" style="background:#f8f9fa;font-size:13px;">
                    <div class="fw-semibold mb-2">Demo акаунти</div>
                    <div><strong>Admin:</strong> admin / admin123</div>
                    <div><strong>User:</strong> user / user123</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

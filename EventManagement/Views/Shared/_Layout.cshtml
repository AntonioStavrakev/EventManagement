<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="site-header">
            <div class="container-xl">
                <nav class="navbar navbar-expand-lg px-0 py-3">
                    <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark__icon">EM</span>
                        <span>
                            <strong>EventManagement</strong>
                            <small>plan. host. join.</small>
                        </span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : string.Empty)"
                                   asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : string.Empty)"
                                   asp-controller="Events" asp-action="Index">Explore</a>
                            </li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" && ViewContext.RouteData.Values["action"]?.ToString() == "MyEvents" ? "active" : string.Empty)"
                                       asp-controller="Events" asp-action="MyEvents">My Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" && ViewContext.RouteData.Values["action"]?.ToString() == "Schedule" ? "active" : string.Empty)"
                                       asp-controller="Events" asp-action="Schedule">My Schedule</a>
                                </li>
                            }
                        </ul>

                        <div class="header-actions">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a class="btn btn-ghost" asp-controller="Account" asp-action="Profile">@User.Identity.Name</a>
                                <a class="btn btn-brand" asp-controller="Events" asp-action="Create">Create Event</a>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light">Logout</button>
                                </form>
                            }
                            else
                            {
                                <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Login</a>
                                <a class="btn btn-brand" asp-controller="Account" asp-action="Register">Register</a>
                            }
                        </div>
                    </div>
                </nav>
            </div>
        </header>

        <main class="container-xl py-4 py-lg-5">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success app-alert" role="alert">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger app-alert" role="alert">@TempData["Error"]</div>
            }

            @RenderBody()
        </main>

        <footer class="site-footer">
            <div class="container-xl d-flex flex-column flex-md-row justify-content-between gap-2">
                <span>&copy; @DateTime.Now.Year EventManagement</span>
                <span>Course-ready event platform with authentication, ownership and registrations.</span>
            </div>
        </footer>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

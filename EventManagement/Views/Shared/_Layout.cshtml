<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventManagement</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --brand: #185FA5;
            --brand-light: #E6F1FB;
            --brand-dark: #0C447C;
        }

        body {
            background: #f8f9fa;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .navbar {
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            box-shadow: 0 1px 3px rgba(0,0,0,.06);
        }

        .navbar-brand {
            font-weight: 600;
            color: var(--brand) !important;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .brand-icon {
            width: 30px;
            height: 30px;
            background: var(--brand);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
        }

        .nav-link {
            color: #555 !important;
            font-size: 14px;
            border-radius: 6px;
            padding: 6px 12px !important;
            transition: all .15s;
        }

        .nav-link:hover, .nav-link.active {
            background: var(--brand-light);
            color: var(--brand) !important;
        }

        .btn-brand {
            background: var(--brand);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 18px;
            font-size: 14px;
            font-weight: 500;
            transition: background .15s;
        }

        .btn-brand:hover {
            background: var(--brand-dark);
            color: white;
        }

        footer {
            background: white;
            border-top: 1px solid #e9ecef;
            padding: 1.5rem 0;
            margin-top: 4rem;
            font-size: 13px;
            color: #888;
            text-align: center;
        }

        .card {
            border: 1px solid #e9ecef;
            border-radius: 12px;
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
        }

        .badge-active   { background: #EAF3DE; color: #3B6D11; }
        .badge-pending  { background: #FAEEDA; color: #854F0B; }
        .badge-cancelled{ background: #FCEBEB; color: #A32D2D; }
        .badge-past     { background: #f0f0f0; color: #666; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg px-4">
        <a class="navbar-brand" asp-controller="Events" asp-action="Index">
            <div class="brand-icon"><i class="bi bi-calendar-event-fill"></i></div>
            EventManagement
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-3 gap-1">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "active" : "")"
                       asp-controller="Events" asp-action="Index">
                        <i class="bi bi-calendar3 me-1"></i>Events
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendees" ? "active" : "")"
                       asp-controller="Attendees" asp-action="Index">
                        <i class="bi bi-people me-1"></i>Attendees
                    </a>
                </li>
            </ul>
            <div class="ms-auto d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-muted" style="font-size:13px;">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary">Login</a>
                }
            </div>
        </div>
    </nav>

    <main class="container-lg py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer>
        <div class="container">
            &copy; @DateTime.Now.Year EventManagement — Antonio Stavrakev
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

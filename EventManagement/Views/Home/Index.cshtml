@model DashboardViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-panel mb-5">
    <div class="row g-4 align-items-center">
        <div class="col-lg-7">
            <span class="hero-chip">Event platform for organizers and attendees</span>
            <h1 class="display-5 mt-3 mb-3">Създавай, управлявай и откривай събития на едно място.</h1>
            <p class="hero-copy mb-4">
                @if (Model.IsAuthenticated)
                {
                    <span>@Model.UserFirstName, всичко ти е подредено: събитията, които организираш, записванията ти и участниците в тях.</span>
                }
                else
                {
                    <span>Започни от началната страница, регистрирай се и веднага създай първото си събитие без хардкоднати потребители и без допълнителна настройка.</span>
                }
            </p>
            <div class="d-flex flex-wrap gap-3">
                @if (Model.IsAuthenticated)
                {
                    <a asp-controller="Events" asp-action="Create" class="btn btn-brand btn-lg">Create Event</a>
                    <a asp-controller="Events" asp-action="MyEvents" class="btn btn-outline-light btn-lg">Manage My Events</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-brand btn-lg">Register</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">Login</a>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <div class="hero-card-grid">
                <article class="metric-card accent-blue">
                    <p>All Events</p>
                    <strong>@Model.TotalEvents</strong>
                </article>
                <article class="metric-card accent-green">
                    <p>Upcoming 7 Days</p>
                    <strong>@Model.UpcomingEvents</strong>
                </article>
                <article class="metric-card accent-gold">
                    <p>Total Registrations</p>
                    <strong>@Model.TotalAttendees</strong>
                </article>
                <article class="metric-card accent-rose">
                    <p>@(Model.IsAuthenticated ? "My Events" : "Active Events")</p>
                    <strong>@(Model.IsAuthenticated ? Model.MyEvents : Model.ActiveEvents)</strong>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="content-card h-100">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Featured</span>
                    <h2>Предстоящи събития</h2>
                </div>
                <a asp-controller="Events" asp-action="Index" class="btn btn-sm btn-outline-dark">View all</a>
            </div>

            @if (Model.RecentEvents.Any())
            {
                <div class="event-list">
                    @foreach (var ev in Model.RecentEvents)
                    {
                        <article class="event-list__item">
                            <div>
                                <p class="event-category">@ev.Category</p>
                                <h3><a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id">@ev.Title</a></h3>
                                <p class="event-meta">@ev.StartDate.ToString("dd MMM yyyy, HH:mm") • @ev.Location • @ev.OrganizerName</p>
                            </div>
                            <div class="event-badges">
                                <span class="status-pill status-pill--@ev.Status.ToLowerInvariant()">@ev.Status</span>
                                <span class="capacity-pill">@ev.CurrentAttendees / @ev.MaxCapacity</span>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <h3>Все още няма публикувани събития</h3>
                    <p>Създай първото и използвай платформата като пълно демо за курса.</p>
                    @if (Model.IsAuthenticated)
                    {
                        <a asp-controller="Events" asp-action="Create" class="btn btn-brand">Create the first event</a>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="content-card h-100">
            <span class="eyebrow">Why it works</span>
            <h2>Готово за предаване</h2>
            <ul class="feature-list">
                <li>Home index page като начален вход към приложението</li>
                <li>Регистрация и login с реални потребители в база</li>
                <li>Само създателят на event може да edit/delete</li>
                <li>Записване за event и управление на участници</li>
                <li>Отделни страници за My Events, Schedule и Profile</li>
            </ul>
        </div>
    </div>
</section>

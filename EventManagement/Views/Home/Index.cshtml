@model EventManagement.Core.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h4 class="fw-semibold mb-1">Dashboard</h4>
        <p class="text-muted mb-0" style="font-size:14px;">Добре дошли! Ето текущото състояние на вашите events.</p>
    </div>
    <a asp-controller="Events" asp-action="Create" class="btn btn-brand">
        <i class="bi bi-plus-lg me-1"></i>Нов Event
    </a>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card p-3">
            <p class="text-muted mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Общо Events</p>
            <p class="mb-0 fw-semibold" style="font-size:28px;color:#185FA5;">@Model.TotalEvents</p>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card p-3">
            <p class="text-muted mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Активни</p>
            <p class="mb-0 fw-semibold" style="font-size:28px;color:#3B6D11;">@Model.ActiveEvents</p>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card p-3">
            <p class="text-muted mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Общо Участници</p>
            <p class="mb-0 fw-semibold" style="font-size:28px;color:#854F0B;">@Model.TotalAttendees</p>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card p-3">
            <p class="text-muted mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Предстоящи (7 дни)</p>
            <p class="mb-0 fw-semibold" style="font-size:28px;color:#A32D2D;">@Model.UpcomingEvents</p>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Upcoming Events Table -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-semibold mb-3">Предстоящи Events</h6>
                @if (Model.RecentEvents.Any())
                {
                    <table class="table table-sm" style="font-size:14px;">
                        <thead>
                            <tr class="text-muted" style="font-size:12px;">
                                <th>Събитие</th>
                                <th>Дата</th>
                                <th>Участници</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in Model.RecentEvents)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id"
                                           class="text-decoration-none fw-semibold" style="color:#185FA5;">
                                            @ev.Title
                                        </a>
                                    </td>
                                    <td class="text-muted">@ev.StartDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-muted">@ev.CurrentAttendees / @ev.MaxCapacity</td>
                                    <td>
                                        <span class="badge badge-@ev.Status.ToString().ToLower()" style="border-radius:20px;padding:4px 10px;font-size:11px;">
                                            @ev.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted text-center py-3" style="font-size:14px;">Няма предстоящи events.</p>
                }
                <a asp-controller="Events" asp-action="Index" class="text-decoration-none" style="font-size:13px;color:#185FA5;">
                    Виж всички →
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-semibold mb-3">Бързи действия</h6>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Events" asp-action="Create"
                       class="btn btn-outline-secondary text-start" style="font-size:13px;">
                        <i class="bi bi-calendar-plus me-2"></i>Създай нов event
                    </a>
                    <a asp-controller="Events" asp-action="Index"
                       class="btn btn-outline-secondary text-start" style="font-size:13px;">
                        <i class="bi bi-list-ul me-2"></i>Управлявай events
                    </a>
                    <a asp-controller="Attendees" asp-action="Index"
                       class="btn btn-outline-secondary text-start" style="font-size:13px;">
                        <i class="bi bi-people me-2"></i>Виж участниците
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

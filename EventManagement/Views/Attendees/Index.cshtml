@model AttendeesViewModel
@{
    ViewData["Title"] = "Attendees";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Attendees</span>
        <h1>@Model.EventTitle</h1>
        <p>@Model.Attendees.Count() регистрирани участници</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-eventId="@Model.EventId" class="btn btn-outline-dark">Export CSV</a>
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-brand">Back to event</a>
    </div>
</section>

<div class="content-card mb-4">
    <form asp-action="Index" method="get" class="row g-3">
        <input type="hidden" name="eventId" value="@Model.EventId" />
        <div class="col-md-6">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="име или имейл" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Status</label>
            <select name="statusFilter" class="form-select">
                <option value="">All</option>
                <option value="Confirmed" selected="@(ViewBag.StatusFilter == "Confirmed" ? "selected" : null)">Confirmed</option>
                <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending" ? "selected" : null)">Pending</option>
                <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled" ? "selected" : null)">Cancelled</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-dark w-100">Filter</button>
        </div>
    </form>
</div>

<div class="content-card">
    @if (Model.Attendees.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Име</th>
                        <th>Имейл</th>
                        <th>Дата</th>
                        <th>Статус</th>
                        <th>Билет</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attendee in Model.Attendees)
                    {
                        <tr>
                            <td>@attendee.FirstName @attendee.LastName</td>
                            <td>@attendee.Email</td>
                            <td>@attendee.RegistrationDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td><span class="status-pill status-pill--active">@attendee.Status</span></td>
                            <td>@attendee.TicketNumber</td>
                            <td class="text-end">
                                <form asp-action="Remove" asp-route-id="@attendee.Id" method="post" onsubmit="return confirm('Премахни участника?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>Няма участници по тези критерии</h3>
            <p>Когато потребители се регистрират, ще ги виждаш тук.</p>
        </div>
    }
</div>
